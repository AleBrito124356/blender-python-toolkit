# Copy this file to .env and edit the values for your machine.
# These variables are read by the Makefile convenience targets (make city,
# make materials, ...). The Python scripts themselves take plain CLI flags and
# do not require any of this, so .env is optional if you call Blender directly.

# Absolute path to your Blender executable.
# Windows: look inside "C:\Program Files\Blender Foundation\Blender X.Y\".
# macOS:   /Applications/Blender.app/Contents/MacOS/Blender
# Linux:   the `blender` binary on your PATH, or its full install path.
BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe

# Directory where renders are written (relative to the repo root).
OUT_DIR=out

# Default render engine for the Makefile targets: eevee (fast, headless-safe)
# or cycles (opt-in, path-traced, slower). EEVEE is strongly recommended.
RENDER_ENGINE=eevee

# Default still resolution as WIDTHxHEIGHT.
RENDER_RESOLUTION=1600x900

# Default EEVEE / Cycles sample count.
RENDER_SAMPLES=64
