# Copy this file to .env and edit the values for your machine.
# Read by the Makefile targets. `bpt` itself only looks at BLENDER_EXE (and
# finds Blender on its own when it is unset), and the Python scripts take plain
# CLI flags, so .env is optional.

# Absolute path to your Blender executable (optional: `bpt doctor` shows what
# auto-discovery picks).
# Windows: "C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"
# macOS:   /Applications/Blender.app/Contents/MacOS/Blender
# Linux:   the `blender` binary on your PATH, or its full install path.
BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Directory where renders are written (relative to the repo root).
OUT_DIR=out

# Default render engine for the Makefile targets: eevee (fast, headless-safe)
# or cycles (path-traced; uses a GPU backend when one works, else the CPU).
RENDER_ENGINE=eevee

# Default still resolution as WIDTHxHEIGHT.
RENDER_RESOLUTION=1600x900

# Default EEVEE / Cycles sample count.
RENDER_SAMPLES=64
